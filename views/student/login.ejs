<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Smart AI Attendance | Student Login
    </title>


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;

            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
        }


        body {

            min-height: 100vh;

            padding: 25px 15px;

            display: flex;

            justify-content: center;

            align-items: center;

            overflow-x: hidden;

            overflow-y: auto;

            color: white;

            background:
                radial-gradient(
                    circle at 50% 35%,
                    rgba(120, 25, 5, 0.30),
                    rgba(20, 5, 3, 0.18) 30%,
                    #030407 72%
                );

            position: relative;
        }


        /* TECH GRID */

        .grid {

            position: fixed;

            inset: 0;

            z-index: 0;

            pointer-events: none;

            background-image:

                linear-gradient(
                    rgba(255, 70, 20, 0.035) 1px,
                    transparent 1px
                ),

                linear-gradient(
                    90deg,
                    rgba(255, 70, 20, 0.035) 1px,
                    transparent 1px
                );

            background-size: 45px 45px;
        }


        /* GLOW */

        .glow {

            position: fixed;

            width: 430px;
            height: 430px;

            left: 50%;
            top: 50%;

            transform:
                translate(-50%, -50%);

            border-radius: 50%;

            background:
                rgba(255, 50, 0, 0.08);

            filter: blur(90px);

            pointer-events: none;

            z-index: 0;
        }


        /* MAIN */

        .wrapper {

            width: 100%;

            max-width: 450px;

            position: relative;

            z-index: 5;

            margin: auto;
        }


        /* ARC REACTOR */

        .reactor {

            width: 76px;
            height: 76px;

            margin: 0 auto 15px;

            border-radius: 50%;

            display: flex;

            justify-content: center;

            align-items: center;

            border: 2px solid #ff4b19;

            box-shadow:

                0 0 10px rgba(255,70,20,.9),

                0 0 25px rgba(255,70,20,.5),

                inset
                0 0 18px rgba(255,70,20,.55);

            animation:
                pulse 2.2s infinite;
        }


        .reactor::before {

            content: "";

            position: absolute;

            width: 57px;
            height: 57px;

            border-radius: 50%;

            border:
                1px dashed
                rgba(255,110,60,.8);
        }


        .core {

            width: 30px;
            height: 30px;

            border-radius: 50%;

            background: white;

            box-shadow:

                0 0 8px white,

                0 0 20px #ff9a6a,

                0 0 38px #ff4010;
        }


        @keyframes pulse {

            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1);
            }
        }


        /* BRAND */

        .brand {

            text-align: center;

            margin-bottom: 20px;
        }


        .brand h1 {

            font-size: 25px;

            letter-spacing: 3px;

            font-weight: 800;

            text-shadow:

                0 0 8px
                rgba(255,255,255,.2),

                0 0 18px
                rgba(255,60,10,.35);
        }


        .brand h1 span {

            color: #ff4b18;
        }


        .brand p {

            margin-top: 8px;

            color: #858991;

            font-size: 9px;

            letter-spacing: 2px;

            text-transform: uppercase;
        }


        /* CARD */

        .card {

            width: 100%;

            padding: 30px;

            position: relative;

            border-radius: 18px;

            background:

                linear-gradient(
                    145deg,
                    rgba(30,32,37,.98),
                    rgba(7,8,11,.98)
                );

            border:
                1px solid
                rgba(255,70,25,.38);

            box-shadow:

                0 0 25px
                rgba(255,50,10,.12),

                0 25px 70px
                rgba(0,0,0,.75);
        }


        /* CORNERS */

        .corner {

            position: absolute;

            width: 35px;
            height: 35px;

            border-color: #ff501d;

            pointer-events: none;
        }


        .tl {

            top: -1px;
            left: -1px;

            border-top: 2px solid;
            border-left: 2px solid;

            border-radius:
                18px 0 0 0;
        }


        .tr {

            top: -1px;
            right: -1px;

            border-top: 2px solid;
            border-right: 2px solid;

            border-radius:
                0 18px 0 0;
        }


        .bl {

            bottom: -1px;
            left: -1px;

            border-bottom: 2px solid;
            border-left: 2px solid;

            border-radius:
                0 0 0 18px;
        }


        .br {

            bottom: -1px;
            right: -1px;

            border-bottom: 2px solid;
            border-right: 2px solid;

            border-radius:
                0 0 18px 0;
        }


        /* STATUS */

        .status {

            display: flex;

            justify-content:
                space-between;

            gap: 10px;

            margin-bottom: 20px;

            color: #686d76;

            font-size: 8px;

            letter-spacing: 1.2px;
        }


        .online {

            color: #ff642d;

            white-space: nowrap;
        }


        .online::before {

            content: "";

            display: inline-block;

            width: 7px;
            height: 7px;

            margin-right: 5px;

            border-radius: 50%;

            background: #ff642d;

            box-shadow:
                0 0 8px #ff642d;
        }


        /* TITLE */

        h2 {

            text-align: center;

            margin-bottom: 22px;

            color: #f2f2f2;

            font-size: 19px;

            letter-spacing: 2px;
        }


        h2 span {

            color: #ff5724;
        }


        /* INPUT */

        .input-group {

            margin-bottom: 15px;
        }


        label {

            display: block;

            margin-bottom: 7px;

            color: #858a93;

            font-size: 9px;

            letter-spacing: 1.5px;

            text-transform: uppercase;
        }


        input {

            display: block;

            width: 100%;

            height: 46px;

            padding: 0 14px;

            border:
                1px solid #373b42;

            border-radius: 8px;

            outline: none;

            background:
                rgba(0,0,0,.48);

            color: white;

            font-size: 14px;

            transition: .25s;
        }


        input::placeholder {

            color: #555b64;
        }


        input:focus {

            border-color:
                #ff5724;

            box-shadow:

                0 0 0 2px
                rgba(255,87,36,.08),

                0 0 18px
                rgba(255,70,20,.18);
        }


        /* LOGIN BUTTON */

        .login-button {

            width: 100%;

            height: 50px;

            margin-top: 6px;

            border:
                1px solid #ff713f;

            border-radius: 8px;

            cursor: pointer;

            color: white;

            font-size: 13px;

            font-weight: bold;

            letter-spacing: 2px;

            background:

                linear-gradient(
                    90deg,
                    #8f1b08,
                    #e84112,
                    #8f1b08
                );

            box-shadow:

                0 0 15px
                rgba(255,60,10,.2);

            transition: .2s;
        }


        .login-button:hover {

            transform:
                translateY(-2px);

            filter:
                brightness(1.12);

            box-shadow:

                0 0 20px
                rgba(255,70,20,.55);
        }


        /* REGISTER */

        .register-link {

            margin-top: 18px;

            text-align: center;

            color: #686d76;

            font-size: 10px;

            letter-spacing: 1px;
        }


        .register-link a {

            color: #ff5a25;

            text-decoration: none;

            font-weight: bold;
        }


        .register-link a:hover {

            color: #ff916b;

            text-shadow:

                0 0 10px
                rgba(255,70,20,.6);
        }


        /* FOOTER */

        .footer {

            margin-top: 16px;

            text-align: center;

            color: #51565e;

            font-size: 8px;

            letter-spacing: 1px;
        }


        .footer span {

            color: #ff5421;
        }


        /* MOBILE */

        @media (max-width: 600px) {

            body {

                align-items: flex-start;

                padding-top: 20px;

                padding-bottom: 30px;
            }


            .brand h1 {

                font-size: 20px;

                letter-spacing: 2px;
            }


            .card {

                padding: 24px 20px;
            }
        }

    </style>

</head>


<body>

    <div class="grid"></div>

    <div class="glow"></div>


    <main class="wrapper">


        <!-- ARC REACTOR -->

        <div class="reactor">

            <div class="core"></div>

        </div>


        <!-- BRAND -->

        <div class="brand">

            <h1>

                SMART
                <span>AI</span>
                ATTENDANCE

            </h1>


            <p>

                Intelligent Attendance Management System

            </p>

        </div>


        <!-- LOGIN CARD -->

        <section class="card">


            <div class="corner tl"></div>

            <div class="corner tr"></div>

            <div class="corner bl"></div>

            <div class="corner br"></div>


            <div class="status">


                <span>

                    STUDENT ACCESS SYSTEM

                </span>


                <span class="online">

                    SYSTEM ONLINE

                </span>


            </div>


            <h2>

                STUDENT
                <span>LOGIN</span>

            </h2>


            <!-- EXISTING LOGIN ROUTE -->

            <form
                action="/student/login"
                method="POST"
            >


                <div class="input-group">


                    <label>

                        Student Email

                    </label>


                    <input
                        type="email"
                        name="email"
                        placeholder="Enter Student Email"
                        autocomplete="email"
                        required
                    >


                </div>


                <div class="input-group">


                    <label>

                        Security Password

                    </label>


                    <input
                        type="password"
                        name="password"
                        placeholder="Enter Password"
                        autocomplete="current-password"
                        required
                    >


                </div>


                <button
                    type="submit"
                    class="login-button"
                >

                    ACCESS STUDENT PORTAL

                </button>


            </form>


            <!-- REGISTER -->

            <div class="register-link">


                New Student?


                <a href="/student/register">

                    Create Student Account

                </a>


            </div>


            <!-- FOOTER -->

            <div class="footer">


                SMART AI ATTENDANCE

                <span>•</span>

                SECURE STUDENT ACCESS PORTAL


            </div>


        </section>


    </main>

</body>

</html>