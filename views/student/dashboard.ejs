<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Smart AI Attendance | Student Dashboard</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        body {

            min-height: 100vh;

            padding: 25px 15px;

            background:
                radial-gradient(
                    circle at 50% 20%,
                    rgba(255, 55, 15, 0.18),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 50% 80%,
                    rgba(0, 180, 255, 0.08),
                    transparent 35%
                ),
                #030407;

            color: #fff;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            overflow-x: hidden;
        }


        /* TECH GRID */

        .grid {

            position: fixed;

            inset: 0;

            pointer-events: none;

            background-image:

                linear-gradient(
                    rgba(255, 70, 20, 0.035) 1px,
                    transparent 1px
                ),

                linear-gradient(
                    90deg,
                    rgba(255, 70, 20, 0.035) 1px,
                    transparent 1px
                );

            background-size: 45px 45px;

            z-index: 0;
        }


        /* MAIN */

        .dashboard {

            width: 100%;

            max-width: 900px;

            margin: auto;

            position: relative;

            z-index: 2;
        }


        /* HEADER */

        .header {

            text-align: center;

            margin-bottom: 25px;
        }


        /* ARC REACTOR */

        .reactor {

            width: 82px;

            height: 82px;

            margin: 0 auto 15px;

            border-radius: 50%;

            display: flex;

            justify-content: center;

            align-items: center;

            border: 2px solid #ff4b19;

            background:
                radial-gradient(
                    circle,
                    rgba(255,255,255,.08),
                    rgba(255,50,0,.03)
                );

            box-shadow:

                0 0 12px
                rgba(255,70,20,.9),

                0 0 30px
                rgba(255,70,20,.5),

                inset
                0 0 20px
                rgba(255,70,20,.5);

            animation:
                pulse 2s infinite;
        }


        .reactor-core {

            width: 31px;

            height: 31px;

            border-radius: 50%;

            background: #fff;

            box-shadow:

                0 0 10px #fff,

                0 0 22px #ff9a6a,

                0 0 40px #ff4010;
        }


        @keyframes pulse {

            50% {
                transform: scale(1.05);
            }
        }


        /* BRAND */

        .brand {

            font-size: 28px;

            font-weight: 800;

            letter-spacing: 3px;
        }


        .brand span {

            color: #ff4b18;

            text-shadow:
                0 0 15px
                rgba(255,70,20,.6);
        }


        .subtitle {

            margin-top: 8px;

            color: #777d87;

            font-size: 10px;

            letter-spacing: 2px;

            text-transform: uppercase;
        }


        /* WELCOME CARD */

        .welcome-card {

            position: relative;

            background:

                linear-gradient(
                    145deg,
                    rgba(30,32,37,.98),
                    rgba(7,8,11,.98)
                );

            border:
                1px solid
                rgba(255,70,25,.35);

            border-radius: 18px;

            padding: 28px;

            margin-bottom: 20px;

            box-shadow:

                0 0 25px
                rgba(255,50,10,.10),

                0 20px 60px
                rgba(0,0,0,.7);
        }


        /* CORNERS */

        .corner {

            position: absolute;

            width: 35px;

            height: 35px;

            border-color: #ff501d;

            pointer-events: none;
        }


        .tl {

            top: -1px;

            left: -1px;

            border-top: 2px solid;

            border-left: 2px solid;

            border-radius:
                18px 0 0 0;
        }


        .tr {

            top: -1px;

            right: -1px;

            border-top: 2px solid;

            border-right: 2px solid;

            border-radius:
                0 18px 0 0;
        }


        .bl {

            bottom: -1px;

            left: -1px;

            border-bottom: 2px solid;

            border-left: 2px solid;

            border-radius:
                0 0 0 18px;
        }


        .br {

            bottom: -1px;

            right: -1px;

            border-bottom: 2px solid;

            border-right: 2px solid;

            border-radius:
                0 0 18px 0;
        }


        /* STATUS */

        .status {

            display: flex;

            justify-content:
                space-between;

            gap: 10px;

            margin-bottom: 20px;

            color: #777d87;

            font-size: 9px;

            letter-spacing: 1.4px;
        }


        .online {

            color: #ff642d;

            white-space: nowrap;
        }


        .online::before {

            content: "";

            display: inline-block;

            width: 7px;

            height: 7px;

            margin-right: 6px;

            border-radius: 50%;

            background: #ff642d;

            box-shadow:
                0 0 8px #ff642d;
        }


        /* WELCOME */

        .welcome {

            color: #fff;

            font-size: 22px;

            margin-bottom: 18px;
        }


        .welcome span {

            color: #ff5724;
        }


        /* STUDENT INFO */

        .info-grid {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 12px;
        }


        .info {

            padding: 16px;

            border:
                1px solid #33373e;

            border-radius: 10px;

            background:
                rgba(0,0,0,.35);
        }


        .info-label {

            color: #737983;

            font-size: 9px;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            margin-bottom: 7px;
        }


        .info-value {

            color: #f1f1f1;

            font-size: 14px;

            word-break: break-word;
        }


        /* ATTENDANCE BUTTON */

        .attendance-btn {

            display: flex;

            align-items: center;

            justify-content: center;

            width: 100%;

            max-width: 420px;

            height: 52px;

            margin: 0 auto 14px;

            padding: 0 22px;

            border:
                1px solid #ff713f;

            border-radius: 8px;

            cursor: pointer;

            text-decoration: none;

            color: white;

            background:

                linear-gradient(
                    90deg,
                    #8f1b08,
                    #e84112,
                    #8f1b08
                );

            font-size: 12px;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            box-shadow:

                0 0 15px
                rgba(255,60,10,.20);

            transition:
                .2s ease;
        }


        .attendance-btn:hover {

            transform:
                translateY(-2px);

            filter:
                brightness(1.12);

            box-shadow:

                0 0 22px
                rgba(255,70,20,.55);
        }


        .attendance-btn:active {

            transform:
                translateY(0);
        }


        /* LOGOUT */

        .logout {

            display: flex;

            align-items: center;

            justify-content: center;

            margin: 0 auto;

            min-width: 190px;

            height: 48px;

            padding: 0 22px;

            border-radius: 8px;

            cursor: pointer;

            text-decoration: none;

            border:
                1px solid #555;

            color: #aaa;

            background: #101216;

            font-size: 12px;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            transition:
                .2s ease;
        }


        .logout:hover {

            color: #ff642d;

            border-color:
                #ff642d;

            box-shadow:

                0 0 15px
                rgba(255,70,20,.2);
        }


        /* FOOTER */

        .footer {

            text-align: center;

            color: #4f545d;

            font-size: 8px;

            letter-spacing: 1.2px;

            margin-top: 22px;
        }


        .footer span {

            color: #ff5421;
        }


        /* MOBILE */

        @media (max-width: 600px) {

            body {

                padding:
                    20px 12px;
            }


            .brand {

                font-size: 21px;

                letter-spacing: 2px;
            }


            .subtitle {

                font-size: 8px;
            }


            .welcome-card {

                padding:
                    22px 17px;
            }


            .info-grid {

                grid-template-columns:
                    1fr;
            }


            .status {

                flex-direction:
                    column;
            }


            .attendance-btn {

                width: 100%;

                max-width: none;
            }


            .logout {

                width: 100%;

                min-width: 0;
            }
        }

    </style>

</head>


<body>


    <div class="grid"></div>


    <main class="dashboard">


        <!-- HEADER -->

        <header class="header">


            <div class="reactor">

                <div class="reactor-core"></div>

            </div>


            <div class="brand">

                SMART
                <span>AI</span>
                ATTENDANCE

            </div>


            <div class="subtitle">

                Intelligent Attendance Management System

            </div>


        </header>


        <!-- STUDENT INFORMATION -->

        <section class="welcome-card">


            <div class="corner tl"></div>

            <div class="corner tr"></div>

            <div class="corner bl"></div>

            <div class="corner br"></div>


            <div class="status">


                <span>

                    STUDENT CONTROL PANEL

                </span>


                <span class="online">

                    SYSTEM ONLINE

                </span>


            </div>


            <h1 class="welcome">

                Welcome,

                <span>

                    <%= student.full_name %>

                </span>

            </h1>


            <div class="info-grid">


                <div class="info">


                    <div class="info-label">

                        Roll Number

                    </div>


                    <div class="info-value">

                        <%= student.roll_no %>

                    </div>


                </div>


                <div class="info">


                    <div class="info-label">

                        Email

                    </div>


                    <div class="info-value">

                        <%= student.email %>

                    </div>


                </div>


            </div>


        </section>


        <!-- AI ATTENDANCE -->

        <a
            href="/student/attendance"
            class="attendance-btn"
        >

            📷 OPEN AI CAMERA

        </a>


        <!-- LOGOUT -->

        <a
            href="/student/logout"
            class="logout"
        >

            Logout

        </a>


        <!-- FOOTER -->

        <div class="footer">

            SMART AI ATTENDANCE

            <span>•</span>

            STUDENT SECURITY PORTAL

        </div>


    </main>


</body>

</html>