
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>JARVIS | Teacher Command Center</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        /* =========================================================
           JARVIS / IRON MAN TEACHER COMMAND CENTER
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --red: #ff1e2d;
            --red-dark: #90000c;
            --red-light: #ff5965;
            --gold: #ffcc45;
            --cyan: #00eaff;
            --green: #00ff9d;

            --dark: #020204;
            --panel: #09090e;

            --text: #ffffff;
            --muted: #777780;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;

            font-family: "Poppins", sans-serif;
            color: var(--text);

            background:
                radial-gradient(
                    circle at 50% 15%,
                    rgba(255, 30, 45, 0.12),
                    transparent 25%
                ),

                radial-gradient(
                    circle at 10% 80%,
                    rgba(255, 100, 0, 0.07),
                    transparent 30%
                ),

                radial-gradient(
                    circle at 90% 10%,
                    rgba(255, 0, 30, 0.08),
                    transparent 25%
                ),

                #020204;

            overflow-x: hidden;
        }


        /* =========================================================
           HUD GRID
        ========================================================= */

        body::before {
            content: "";

            position: fixed;
            inset: 0;

            pointer-events: none;

            background:
                linear-gradient(
                    rgba(255, 30, 45, 0.025) 1px,
                    transparent 1px
                ),

                linear-gradient(
                    90deg,
                    rgba(255, 30, 45, 0.025) 1px,
                    transparent 1px
                );

            background-size: 42px 42px;

            z-index: 0;
        }


        body::after {
            content: "";

            position: fixed;
            inset: 0;

            pointer-events: none;

            background:
                linear-gradient(
                    180deg,
                    transparent 0%,
                    rgba(255, 0, 0, 0.025) 50%,
                    transparent 100%
                );

            animation: hudScan 6s linear infinite;

            z-index: 1;
        }


        @keyframes hudScan {

            0% {
                transform: translateY(-100%);
            }

            100% {
                transform: translateY(100%);
            }

        }


        /* =========================================================
           NAVBAR
        ========================================================= */

        .navbar {

            height: 76px;

            padding: 0 35px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            background:
                linear-gradient(
                    180deg,
                    rgba(20, 5, 8, 0.97),
                    rgba(7, 5, 8, 0.94)
                );

            border-bottom:
                1px solid rgba(255, 30, 45, 0.35);

            box-shadow:
                0 0 30px rgba(255, 0, 30, 0.10);

            backdrop-filter: blur(20px);

            position: sticky;
            top: 0;

            z-index: 100;
        }


        .brand {

            display: flex;
            align-items: center;

            gap: 14px;
        }


        .brand-icon {

            width: 48px;
            height: 48px;

            display: flex;
            justify-content: center;
            align-items: center;

            border: 2px solid var(--red);
            border-radius: 50%;

            color: #fff;

            font-size: 20px;

            background:
                radial-gradient(
                    circle,
                    #fff 0%,
                    #ffcc45 10%,
                    #ff2b35 28%,
                    #69000a 48%,
                    #080306 70%
                );

            box-shadow:
                0 0 8px #ff1e2d,
                0 0 20px rgba(255, 30, 45, 0.8),
                0 0 45px rgba(255, 30, 45, 0.35);

            animation:
                reactorPulse 1.8s ease-in-out infinite;
        }


        @keyframes reactorPulse {

            0%,
            100% {

                box-shadow:
                    0 0 8px #ff1e2d,
                    0 0 20px rgba(255, 30, 45, 0.7),
                    0 0 40px rgba(255, 30, 45, 0.25);
            }


            50% {

                box-shadow:
                    0 0 15px #ffcc45,
                    0 0 35px rgba(255, 30, 45, 1),
                    0 0 65px rgba(255, 30, 45, 0.5);
            }

        }


        .brand h2 {

            font-family: "Orbitron", sans-serif;

            font-size: 17px;

            letter-spacing: 2px;
        }


        .brand small {

            display: block;

            color: #ff6b73;

            font-size: 8px;

            letter-spacing: 3px;

            margin-top: 2px;
        }


        .teacher-info {

            display: flex;
            align-items: center;

            gap: 12px;
        }


        .teacher-badge {

            padding: 9px 15px;

            border:
                1px solid rgba(255, 30, 45, 0.4);

            border-radius: 9px;

            background:
                rgba(255, 30, 45, 0.08);

            color: #ffcc45;

            font-family:
                "Orbitron", sans-serif;

            font-size: 11px;
        }


        .logout {

            text-decoration: none;

            color: #ff555f;

            border:
                1px solid rgba(255, 30, 45, 0.45);

            padding: 9px 15px;

            border-radius: 8px;

            font-family:
                "Orbitron", sans-serif;

            font-size: 10px;

            letter-spacing: 1px;

            transition: 0.25s;
        }


        .logout:hover {

            color: white;

            background:
                rgba(255, 30, 45, 0.20);

            box-shadow:
                0 0 20px rgba(255, 30, 45, 0.35);

            transform:
                translateY(-2px);
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .main {

            width: min(1400px, 94%);

            margin: auto;

            padding:
                40px 0 80px;

            position: relative;

            z-index: 2;
        }


        /* =========================================================
           WELCOME
        ========================================================= */

        .welcome {

            margin-bottom: 28px;

            padding-left: 5px;
        }


        .welcome h1 {

            font-family:
                "Orbitron", sans-serif;

            font-size: 30px;

            letter-spacing: 1px;

            margin-bottom: 7px;
        }


        .welcome h1 span {

            color: #ff2635;

            text-shadow:
                0 0 8px rgba(255, 30, 45, 0.8),
                0 0 25px rgba(255, 30, 45, 0.35);
        }


        .welcome p {

            color: #777;

            font-size: 12px;

            letter-spacing: 1px;
        }


        /* =========================================================
           JARVIS PANEL
        ========================================================= */

        .jarvis-panel {

            width: 100%;

            min-height: 150px;

            margin-bottom: 28px;

            padding: 24px;

            display: flex;
            align-items: center;

            gap: 24px;

            position: relative;

            overflow: hidden;

            background:
                linear-gradient(
                    135deg,
                    rgba(8, 15, 28, 0.98),
                    rgba(14, 8, 12, 0.98)
                );

            border:
                1px solid rgba(255, 30, 45, 0.35);

            border-radius: 18px;

            box-shadow:
                0 0 30px rgba(255, 30, 45, 0.12);
        }


        .jarvis-panel::before {

            content: "";

            position: absolute;

            top: 0;
            left: 0;

            width: 100%;
            height: 2px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    #ff1e2d,
                    #ffcc45,
                    #ff1e2d,
                    transparent
                );
        }


        .jarvis-orb {

            width: 88px;
            height: 88px;

            min-width: 88px;

            border-radius: 50%;

            display: flex;
            justify-content: center;
            align-items: center;

            position: relative;

            background:
                radial-gradient(
                    circle,
                    #ff3342 0%,
                    #8d000c 38%,
                    #180205 72%
                );

            border:
                2px solid rgba(255, 30, 45, 0.8);

            box-shadow:
                0 0 15px rgba(255, 30, 45, 0.8),
                0 0 40px rgba(255, 30, 45, 0.45);
        }


        .jarvis-orb::before {

            content: "";

            position: absolute;

            width: 110px;
            height: 110px;

            border-radius: 50%;

            border:
                1px solid rgba(255, 30, 45, 0.35);
        }


        .jarvis-orb::after {

            content: "";

            position: absolute;

            width: 130px;
            height: 130px;

            border-radius: 50%;

            border:
                1px dashed rgba(255, 204, 69, 0.25);
        }


        .jarvis-core {

            width: 48px;
            height: 48px;

            border-radius: 50%;

            display: flex;
            justify-content: center;
            align-items: center;

            background:
                linear-gradient(
                    135deg,
                    #ff5965,
                    #b00012
                );

            font-size: 24px;

            font-weight: bold;

            box-shadow:
                0 0 20px rgba(255, 30, 45, 0.8);

            z-index: 2;
        }


        .jarvis-listening {

            animation:
                jarvisPulse 1s infinite;
        }


        @keyframes jarvisPulse {

            0%,
            100% {

                transform:
                    scale(1);
            }


            50% {

                transform:
                    scale(1.08);

                box-shadow:
                    0 0 30px rgba(255, 30, 45, 1),
                    0 0 80px rgba(255, 30, 45, 0.7);
            }

        }


        .jarvis-information {

            flex: 1;
        }


        .jarvis-header {

            display: flex;

            justify-content:
                space-between;

            align-items:
                center;

            gap: 15px;

            margin-bottom: 14px;
        }


        .jarvis-title {

            color: #ffcc45;

            font-size: 15px;

            font-weight: 800;

            letter-spacing: 1.5px;
        }


        .jarvis-status {

            padding:
                6px 10px;

            color:
                #ff5965;

            font-size:
                9px;

            font-weight:
                800;

            letter-spacing:
                1px;

            border:
                1px solid rgba(255, 30, 45, 0.35);

            border-radius:
                20px;

            background:
                rgba(255, 30, 45, 0.06);
        }


        .jarvis-text {

            color:
                #b9b9b9;

            font-size:
                13px;

            line-height:
                1.6;

            margin-bottom:
                16px;
        }


        .jarvis-commands {

            display:
                flex;

            flex-wrap:
                wrap;

            gap:
                8px;
        }


        .jarvis-commands span {

            padding:
                6px 10px;

            color:
                #888;

            font-size:
                8px;

            font-weight:
                700;

            letter-spacing:
                0.8px;

            border:
                1px solid rgba(255, 255, 255, 0.08);

            border-radius:
                5px;
        }


        .jarvis-button {

            width: 64px;
            height: 64px;

            min-width: 64px;

            border: none;

            border-radius: 50%;

            cursor: pointer;

            color: white;

            font-size: 24px;

            background:
                linear-gradient(
                    135deg,
                    #ff1e2d,
                    #87000b
                );

            box-shadow:
                0 0 20px rgba(255, 30, 45, 0.35);

            transition:
                0.25s;
        }


        .jarvis-button:hover {

            transform:
                scale(1.08);

            box-shadow:
                0 0 35px rgba(255, 30, 45, 0.7);
        }


        .jarvis-active {

            animation:
                microphonePulse 0.8s infinite;
        }


        @keyframes microphonePulse {

            50% {

                transform:
                    scale(1.12);
            }

        }


        /* =========================================================
           PANELS
        ========================================================= */

        .panel {

            position:
                relative;

            background:
                linear-gradient(
                    145deg,
                    rgba(20, 9, 12, 0.94),
                    rgba(7, 7, 10, 0.95)
                );

            border:
                1px solid rgba(255, 30, 45, 0.20);

            border-radius:
                16px;

            padding:
                24px;

            margin-bottom:
                22px;

            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.5),
                inset 0 0 25px rgba(255, 30, 45, 0.025);

            overflow:
                hidden;
        }


        .panel::before {

            content:
                "";

            position:
                absolute;

            top:
                0;

            left:
                0;

            width:
                100%;

            height:
                2px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    #ff1e2d,
                    #ffcc45,
                    #ff1e2d,
                    transparent
                );
        }


        .panel-title {

            display:
                flex;

            justify-content:
                space-between;

            align-items:
                center;

            gap:
                15px;

            margin-bottom:
                20px;
        }


        .panel-title h2 {

            font-family:
                "Orbitron", sans-serif;

            font-size:
                14px;

            letter-spacing:
                1px;
        }


        .panel-title small {

            color:
                #777;

            font-size:
                10px;
        }


        /* =========================================================
           TOP GRID
        ========================================================= */

        .top-grid {

            display:
                grid;

            grid-template-columns:
                1.35fr 0.65fr;

            gap:
                22px;
        }


        /* =========================================================
           SESSION
        ========================================================= */

        .session-box {

            padding:
                22px;

            border-radius:
                14px;

            border:
                1px solid rgba(255, 30, 45, 0.25);

            background:
                rgba(255, 30, 45, 0.025);
        }


        .session-status {

            display:
                flex;

            align-items:
                center;

            gap:
                8px;

            color:
                #ffcc45;

            font-family:
                "Orbitron", sans-serif;

            font-size:
                10px;

            letter-spacing:
                1px;

            margin-bottom:
                13px;
        }


        .session-status.off {

            color:
                #888;
        }


        .dot {

            width:
                9px;

            height:
                9px;

            border-radius:
                50%;

            background:
                #ff1e2d;

            box-shadow:
                0 0 10px #ff1e2d;

            animation:
                dotPulse 1.2s infinite;
        }


        .dot.off {

            background:
                #666;

            animation:
                none;

            box-shadow:
                none;
        }


        @keyframes dotPulse {

            50% {

                opacity:
                    0.4;

                transform:
                    scale(0.7);
            }

        }


        .session-name {

            font-family:
                "Orbitron", sans-serif;

            font-size:
                20px;

            color:
                white;

            margin-bottom:
                7px;
        }


        .session-id {

            color:
                #777;

            font-size:
                10px;

            margin-bottom:
                18px;
        }


        /* =========================================================
           FORM
        ========================================================= */

        .create-form {

            display:
                flex;

            gap:
                10px;
        }


        .create-form input {

            flex:
                1;

            padding:
                13px 15px;

            border-radius:
                9px;

            border:
                1px solid rgba(255, 30, 45, 0.22);

            background:
                #050508;

            color:
                white;

            outline:
                none;
        }


        .create-form input:focus {

            border-color:
                #ff1e2d;

            box-shadow:
                0 0 15px rgba(255, 30, 45, 0.16);
        }


        .create-btn,
        .approve-btn {

            border:
                none;

            padding:
                12px 18px;

            border-radius:
                8px;

            cursor:
                pointer;

            color:
                white;

            font-family:
                "Orbitron", sans-serif;

            font-size:
                9px;

            letter-spacing:
                1px;

            background:
                linear-gradient(
                    135deg,
                    #ff1e2d,
                    #a90010
                );
        }


        .end-btn {

            border:
                1px solid rgba(255, 30, 45, 0.45);

            background:
                rgba(255, 30, 45, 0.08);

            color:
                #ff5862;

            padding:
                10px 18px;

            border-radius:
                8px;

            cursor:
                pointer;

            font-family:
                "Orbitron", sans-serif;

            font-size:
                9px;
        }


        /* =========================================================
           STATS
        ========================================================= */

        .stats {

            display:
                grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap:
                12px;
        }


        .stat {

            padding:
                18px;

            border-radius:
                12px;

            background:
                rgba(255, 30, 45, 0.04);

            border:
                1px solid rgba(255, 30, 45, 0.14);
        }


        .stat-icon {

            font-size:
                19px;

            margin-bottom:
                8px;
        }


        .stat-number {

            font-family:
                "Orbitron", sans-serif;

            font-size:
                24px;

            font-weight:
                700;

            color:
                #ff3342;
        }


        .stat-label {

            color:
                #777;

            font-size:
                8px;

            margin-top:
                4px;

            letter-spacing:
                1px;
        }


        /* =========================================================
           SEARCH
        ========================================================= */

        .search-box {

            width:
                100%;

            margin-bottom:
                18px;
        }


        .search-box input {

            width:
                100%;

            padding:
                13px 16px;

            background:
                #050508;

            border:
                1px solid rgba(255, 30, 45, 0.20);

            border-radius:
                9px;

            color:
                white;

            outline:
                none;

            font-family:
                "Poppins", sans-serif;
        }


        .search-box input:focus {

            border-color:
                #ff1e2d;

            box-shadow:
                0 0 18px rgba(255, 30, 45, 0.12);
        }


        /* =========================================================
           TABLE
        ========================================================= */

        .table-wrapper {

            overflow-x:
                auto;

            border-radius:
                10px;
        }


        table {

            width:
                100%;

            border-collapse:
                collapse;
        }


        th {

            text-align:
                left;

            color:
                #9b5258;

            font-family:
                "Orbitron", sans-serif;

            font-size:
                8px;

            letter-spacing:
                1px;

            padding:
                13px;

            border-bottom:
                1px solid rgba(255, 30, 45, 0.18);

            white-space:
                nowrap;
        }


        td {

            padding:
                13px;

            border-bottom:
                1px solid rgba(255, 255, 255, 0.035);

            font-size:
                11px;

            white-space:
                nowrap;
        }


        tr:hover td {

            background:
                rgba(255, 30, 45, 0.035);
        }


        /* =========================================================
           PHOTOS
        ========================================================= */

        .student-photo {

            width:
                46px;

            height:
                46px;

            border-radius:
                50%;

            object-fit:
                cover;

            border:
                2px solid rgba(255, 30, 45, 0.55);
        }


        .attendance-photo {

            width:
                42px;

            height:
                42px;

            border-radius:
                50%;

            object-fit:
                cover;

            border:
                2px solid rgba(255, 30, 45, 0.5);
        }


        .student-name {

            color:
                white;

            font-weight:
                600;
        }


        .student-email {

            color:
                #777;

            font-size:
                9px;
        }


        /* =========================================================
           BADGES
        ========================================================= */

        .approved {

            display:
                inline-block;

            color:
                #ffcc45;

            background:
                rgba(255, 204, 69, 0.06);

            border:
                1px solid rgba(255, 204, 69, 0.25);

            padding:
                5px 9px;

            border-radius:
                6px;

            font-family:
                "Orbitron", sans-serif;

            font-size:
                8px;
        }


        .pending {

            display:
                inline-block;

            color:
                #ff6b73;

            background:
                rgba(255, 30, 45, 0.07);

            border:
                1px solid rgba(255, 30, 45, 0.25);

            padding:
                5px 9px;

            border-radius:
                6px;

            font-family:
                "Orbitron", sans-serif;

            font-size:
                8px;
        }


        /* =========================================================
           EMPTY
        ========================================================= */

        .empty {

            text-align:
                center;

            color:
                #666;

            padding:
                45px 20px;

            font-family:
                "Orbitron", sans-serif;

            font-size:
                10px;

            letter-spacing:
                1px;

            border:
                1px dashed rgba(255, 30, 45, 0.15);

            border-radius:
                10px;
        }


        /* =========================================================
           LIVE
        ========================================================= */

        .live {

            display:
                inline-flex;

            align-items:
                center;

            gap:
                6px;

            color:
                #ff3342;

            font-family:
                "Orbitron", sans-serif;

            font-size:
                8px;
        }


        .live-dot {

            width:
                7px;

            height:
                7px;

            border-radius:
                50%;

            background:
                #ff1e2d;

            box-shadow:
                0 0 8px #ff1e2d;

            animation:
                pulse 1s infinite;
        }


        @keyframes pulse {

            50% {

                opacity:
                    0.3;
            }

        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 900px) {

            .top-grid {

                grid-template-columns:
                    1fr;
            }

        }


        @media (max-width: 650px) {

            .navbar {

                padding:
                    0 15px;

                height:
                    68px;
            }


            .brand-icon {

                width:
                    40px;

                height:
                    40px;
            }


            .brand h2 {

                font-size:
                    13px;
            }


            .teacher-badge {

                display:
                    none;
            }


            .main {

                width:
                    94%;

                padding-top:
                    25px;
            }


            .stats {

                grid-template-columns:
                    1fr;
            }


            .create-form {

                flex-direction:
                    column;
            }


            .panel {

                padding:
                    18px;
            }


            .welcome h1 {

                font-size:
                    22px;
            }


            .jarvis-panel {

                padding:
                    18px;

                gap:
                    15px;

                flex-wrap:
                    wrap;
            }


            .jarvis-orb {

                width:
                    65px;

                height:
                    65px;

                min-width:
                    65px;
            }


            .jarvis-orb::before {

                width:
                    78px;

                height:
                    78px;
            }


            .jarvis-orb::after {

                display:
                    none;
            }


            .jarvis-button {

                width:
                    55px;

                height:
                    55px;

                min-width:
                    55px;
            }


            .jarvis-header {

                flex-direction:
                    column;

                align-items:
                    flex-start;
            }

        }

    </style>

</head>


<body>


    <!-- =====================================================
         NAVBAR
    ===================================================== -->

    <nav class="navbar">

        <div class="brand">

            <div class="brand-icon">
                ◉
            </div>

            <div>

                <h2>JARVIS COMMAND</h2>

                <small>
                    AI ATTENDANCE SYSTEM
