            "Pending student approvals open kar raha hoon."
        );


        return;

    }


    /* =====================================================
       REFRESH
    ===================================================== */

    if (

        hasAny(command, [

            "refresh",

            "reload",

            "refresh page",

            "reload page"

        ])

    ) {

        updateJarvis(
            "REFRESHING",
            "Refreshing the command center."
        );


        speak(
            "Command center refresh kar raha hoon."
        );


        setTimeout(() => {

            window.location.reload();

        }, 1200);


        return;

    }


    /* =====================================================
       HELP
    ===================================================== */

    if (

        hasAny(command, [

            "help",

            "commands",

            "what can you do",

            "madad",

            "kya kar sakte ho"

        ])

    ) {

        const helpText =
            "You can ask who is present, who is absent, check student attendance, count present or absent students, show attendance, show students, create session, end session, search students, approve students, or refresh.";


        updateJarvis(
            "AVAILABLE COMMANDS",
            helpText
        );


        speak(
            "Aap pooch sakte hain kaun present hai, kaun absent hai, kisi student ki attendance, kitne students present ya absent hain, attendance dikhao, students dikhao, session create karo ya end session."
        );


        return;

    }

/* =====================================================
   REAL WORLD AI + NEWS SEARCH
===================================================== */

updateJarvis(
    "JARVIS THINKING",
    "Searching for: " + originalCommand
);

speak(
    "Ek moment Sir, main iske baare mein information check kar raha hoon."
);


/* =====================================================
   SEND REAL WORLD QUESTION TO SERVER
===================================================== */

fetch("/teacher/jarvis/command", {

    method: "POST",

    headers: {
        "Content-Type": "application/json"
    },

    body: JSON.stringify({
        command: originalCommand
    })

})

.then(function (response) {

    if (!response.ok) {

        throw new Error(
            "JARVIS server response failed"
        );

    }

    return response.json();

})

.then(function (data) {

    console.log(
        "JARVIS SERVER RESPONSE:",
        data
    );


    if (data && data.response) {

        updateJarvis(
            "JARVIS RESPONSE",
            data.response
        );

        speak(
            data.response
        );

        return;

    }


    updateJarvis(
        "JARVIS RESPONSE",
        "Sir, mujhe is question ka answer nahi mila."
    );


    speak(
        "Sir, mujhe is question ka reliable answer nahi mila."
    );

})

.catch(function (error) {

    console.error(
        "JARVIS REAL WORLD SEARCH ERROR:",
        error
    );


    updateJarvis(
        "JARVIS CONNECTION ERROR",
        "Unable to connect to JARVIS AI server."
    );


    speak(
        "Sorry Sir, main abhi internet information service se connect nahi kar pa raha hoon."
    );

});


return;
}


/* =========================================================
   RESTART LISTENING
========================================================= */

function restartListening(delay = 500) {

    clearTimeout(restartTimer);


    if (!jarvisEnabled) {

        return;

    }


    if (isSpeaking) {

        return;

    }


    restartTimer =
        setTimeout(() => {

            startListening();

        }, delay);

}


/* =========================================================
   START LISTENING
========================================================= */

function startListening() {

    if (!jarvisEnabled) {

        return;

    }


    if (!recognition) {

        return;

    }


    if (recognitionRunning) {

        return;

    }


    try {

        recognition.start();

    } catch (error) {

        console.log(
            "Recognition start error:",
            error
        );


        restartListening(1000);

    }

}


/* =========================================================
   STOP JARVIS
========================================================= */

function stopJarvis() {

    jarvisEnabled = false;


    clearTimeout(restartTimer);


    if (window.speechSynthesis) {

        window.speechSynthesis.cancel();

    }


    isSpeaking = false;


    try {

        if (recognition) {

            recognition.stop();

        }

    } catch (error) {

        console.log(error);

    }


    recognitionRunning = false;


    removeJarvisListeningUI();


    updateJarvis(
        "SYSTEM READY",
        "JARVIS is offline. Click microphone to activate."
    );


    if (jarvisButton) {

        jarvisButton.title =
            "Activate JARVIS";

    }

}


/* =========================================================
   ACTIVATE JARVIS
========================================================= */

function activateJarvis() {

    jarvisEnabled = true;


    updateJarvis(
        "JARVIS ONLINE",
        "Continuous listening activated. Speak naturally."
    );


    if (jarvisButton) {

        jarvisButton.title =
            "Stop JARVIS";

    }


    speak(
        "JARVIS online. Main continuous listening mode mein hoon. Aap attendance ke baare mein kuch bhi pooch sakte hain."
    );

}


/* =========================================================
   INITIALIZE SPEECH RECOGNITION
========================================================= */

if (SpeechRecognition) {

    recognition =
        new SpeechRecognition();


    recognition.continuous = false;

    recognition.interimResults = false;

    recognition.maxAlternatives = 3;


    /*
       Hindi + Hinglish recognition
    */

    recognition.lang = "en-IN";


    /* =====================================================
       START
    ===================================================== */

    recognition.onstart =
        function () {

            recognitionRunning = true;


            setJarvisListeningUI();


            updateJarvis(
                "LISTENING...",
                "JARVIS is listening. Speak naturally."
            );

        };


    /* =====================================================
       RESULT
    ===================================================== */

    recognition.onresult =
        function (event) {

            let bestCommand = "";


            const results =
                event.results[0];


            for (

                let i = 0;

                i < results.length;

                i++

            ) {

                const transcript =
                    results[i].transcript;


                if (transcript) {

                    bestCommand =
                        transcript.trim();

                    break;

                }

            }


            if (bestCommand) {

    console.log(
        "JARVIS HEARD:",
        bestCommand
    );

    executeJarvisCommand(
    bestCommand
);

}

        };


    /* =====================================================
       ERROR
    ===================================================== */

    recognition.onerror =
        function (event) {

            console.log(
                "Speech Recognition Error:",
                event.error
            );


            recognitionRunning = false;


            if (
                event.error === "not-allowed" ||
                event.error === "service-not-allowed"
            ) {

                jarvisEnabled = false;


                removeJarvisListeningUI();


                updateJarvis(
                    "MICROPHONE BLOCKED",
                    "Please allow microphone permission in Chrome."
                );


                return;

            }


            if (event.error === "no-speech") {

                if (jarvisEnabled) {

                    restartListening(500);

                }


                return;

            }


            if (event.error === "aborted") {

                return;

            }


            if (event.error === "network") {

                updateJarvis(
                    "VOICE NETWORK ERROR",
                    "Speech recognition requires internet."
                );


                if (jarvisEnabled) {

                    restartListening(2000);

                }


                return;

            }


            if (jarvisEnabled) {

                restartListening(1000);

            }

        };


    /* =====================================================
       END
    ===================================================== */

    recognition.onend =
        function () {

            recognitionRunning = false;


            if (

                jarvisEnabled &&

                !isSpeaking

            ) {

                restartListening(500);

            }

        };


    /* =====================================================
       MICROPHONE BUTTON
    ===================================================== */

    if (jarvisButton) {

        jarvisButton.addEventListener(
            "click",
            function () {

                if (jarvisEnabled) {

                    stopJarvis();

                } else {

                    activateJarvis();

                }

            }
        );

    }


} else {


    if (jarvisButton) {

        jarvisButton.addEventListener(
            "click",
            function () {

                updateJarvis(
                    "NOT SUPPORTED",
                    "Speech recognition is not supported. Please use Google Chrome."
                );

            }
        );

    }

}

</script>

</body>

</html>