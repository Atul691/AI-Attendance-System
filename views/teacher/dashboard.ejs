<script>

/* =========================================================
   STUDENT SEARCH
========================================================= */

const studentSearch = document.getElementById("studentSearch");

if (studentSearch) {

    studentSearch.addEventListener("input", function () {

        const searchValue = this.value.toLowerCase().trim();

        const rows = document.querySelectorAll(".student-row");

        rows.forEach(row => {

            const text = row.textContent.toLowerCase();

            row.style.display =
                text.includes(searchValue)
                    ? ""
                    : "none";

        });

    });

}
/* =========================================================
   JARVIS ELEMENTS
========================================================= */

const jarvisButton = document.getElementById("jarvisButton");

const jarvisOrb = document.getElementById("jarvisOrb");

const jarvisStatus = document.getElementById("jarvisStatus");

const jarvisText = document.getElementById("jarvisText");


/* =========================================================
   SPEECH RECOGNITION
========================================================= */

const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;


/* =========================================================
   JARVIS SETTINGS
========================================================= */

let jarvisEnabled = false;

let recognitionRunning = false;

let isSpeaking = false;

let restartTimer = null;

let recognition = null;


/* =========================================================
   UPDATE JARVIS UI
========================================================= */

function updateJarvis(status, text) {

    if (jarvisStatus) {

        jarvisStatus.textContent = status;

    }

    if (jarvisText) {

        jarvisText.textContent = text;

    }

}


/* =========================================================
   LISTENING UI ON
========================================================= */

function setJarvisListeningUI() {

    if (jarvisButton) {

        jarvisButton.classList.add("jarvis-active");

    }

    if (jarvisOrb) {

        jarvisOrb.classList.add("jarvis-listening");

    }

}


/* =========================================================
   LISTENING UI OFF
========================================================= */

function removeJarvisListeningUI() {

    if (jarvisButton) {

        jarvisButton.classList.remove("jarvis-active");

    }

    if (jarvisOrb) {

        jarvisOrb.classList.remove("jarvis-listening");

    }

}


/* =========================================================
   SPEAK FUNCTION
========================================================= */

/* =========================================================
   IMPROVED JARVIS SPEAK FUNCTION
========================================================= */

function speak(text, language = "hi-IN") {

    if (!("speechSynthesis" in window)) {

        console.log("Speech synthesis not supported");

        return;

    }

    window.speechSynthesis.cancel();

    clearTimeout(restartTimer);

    isSpeaking = true;

    updateJarvis(
        "JARVIS SPEAKING",
        text
    );

    const speech =
        new SpeechSynthesisUtterance(text);

    speech.lang = language;

    speech.rate = 0.9;

    speech.pitch = 0.9;

    speech.volume = 1;

    const voices =
        window.speechSynthesis.getVoices();

    const hindiVoice =
        voices.find(voice =>
            voice.lang === "hi-IN"
        );

    const englishVoice =
        voices.find(voice =>
            voice.lang === "en-IN"
        );

    if (hindiVoice) {

        speech.voice = hindiVoice;

    } else if (englishVoice) {

        speech.voice = englishVoice;

    }

    speech.onstart = function () {

        console.log(
            "JARVIS STARTED SPEAKING:",
            text
        );

    };

    speech.onend = function () {

        console.log(
            "JARVIS FINISHED SPEAKING"
        );

        isSpeaking = false;

        if (jarvisEnabled) {

            restartListening(1000);

        }

    };

    speech.onerror = function (event) {

        console.log(
            "Speech Error:",
            event
        );

        isSpeaking = false;

        if (jarvisEnabled) {

            restartListening(1000);

        }

    };

    setTimeout(() => {

        window.speechSynthesis.speak(speech);

    }, 200);

}


/* =========================================================
   LOAD AVAILABLE VOICES
========================================================= */

window.speechSynthesis.onvoiceschanged =
    function () {

        console.log(
            "JARVIS Voices Loaded:",
            window.speechSynthesis.getVoices()
        );

    };



/* =========================================================
   NORMALIZE COMMAND
========================================================= */

function normalizeCommand(command) {

    return command

        .toLowerCase()

        .trim()

        .replace(/[?.,!]/g, "")


        /* JARVIS */

        .replace(/जार्विस/g, "jarvis")


        /* ATTENDANCE */

        .replace(/अटेंडेंस/g, "attendance")

        .replace(/हाजिरी/g, "attendance")

        .replace(/हाजरी/g, "attendance")


        /* STUDENT */

        .replace(/स्टूडेंट्स/g, "students")

        .replace(/स्टूडेंट/g, "student")

        .replace(/छात्रों/g, "students")

        .replace(/छात्र/g, "student")


        /* SESSION */

        .replace(/सेशन/g, "session")

        .replace(/सत्र/g, "session")


        /* ACTIONS */

        .replace(/दिखाओ/g, "show")

        .replace(/दिखा/g, "show")

        .replace(/बताओ/g, "tell")

        .replace(/बता/g, "tell")

        .replace(/खोलो/g, "open")

        .replace(/सर्च/g, "search")

        .replace(/ढूंढो/g, "find")

        .replace(/रिफ्रेश/g, "refresh")

        .replace(/मदद/g, "help")


        /* SESSION ACTIONS */

        .replace(/बनाओ/g, "create")

        .replace(/बना दो/g, "create")

        .replace(/बनाना/g, "create")

        .replace(/शुरू/g, "start")

        .replace(/चालू/g, "start")

        .replace(/बंद/g, "end")

        .replace(/खत्म/g, "end")

        .replace(/\s+/g, " ")

        .trim();

}


/* =========================================================
   CHECK ANY COMMAND
========================================================= */

function hasAny(command, words) {

    return words.some(word =>
        command.includes(word)
    );

}


/* =========================================================
   CLEAN STUDENT NAME
========================================================= */

function cleanStudentName(name) {

    return name
        .toLowerCase()
        .trim()
        .replace(/\s+/g, " ");

}


/* =========================================================
   GET ALL REGISTERED STUDENTS
========================================================= */

function getAllStudents() {

    const students = [];


    const rows =
        document.querySelectorAll(
            "#studentsTable tbody tr.student-row"
        );


    rows.forEach(row => {

        const nameElement =
            row.querySelector(".student-name");


        if (!nameElement) {

            return;

        }


        const cells =
            row.querySelectorAll("td");


        const name =
            nameElement.textContent.trim();


        students.push({

            name: name,

            rollNo:
                cells[2]
                    ? cells[2].textContent.trim()
                    : "",

            email:
                cells[3]
                    ? cells[3].textContent.trim()
                    : ""

        });

    });


    return students;

}


/* =========================================================
   GET PRESENT STUDENTS
========================================================= */

function getPresentStudents() {

    const students = [];


    const rows =
        document.querySelectorAll(
            "#attendanceTable tbody tr"
        );


    rows.forEach(row => {

        const nameElement =
            row.querySelector(".student-name");


        if (!nameElement) {

            return;

        }


        const cells =
            row.querySelectorAll("td");


        students.push({

            name:
                nameElement.textContent.trim(),

            rollNo:
                cells[2]
                    ? cells[2].textContent.trim()
                    : "",

            email:
                cells[3]
                    ? cells[3].textContent.trim()
                    : ""

        });

    });


    return students;

}


/* =========================================================
   GET ABSENT STUDENTS
========================================================= */

function getAbsentStudents() {

    const allStudents =
        getAllStudents();


    const presentStudents =
        getPresentStudents();


    const presentNames =
        presentStudents.map(student =>
            cleanStudentName(student.name)
        );


    return allStudents.filter(student =>

        !presentNames.includes(
            cleanStudentName(student.name)
        )

    );

}


/* =========================================================
   FIND STUDENT
========================================================= */

function findStudentByName(searchName) {

    const students =
        getAllStudents();


    searchName =
        cleanStudentName(searchName);


    if (!searchName) {

        return null;

    }


    /* EXACT MATCH */

    let found =
        students.find(student =>

            cleanStudentName(student.name) ===
            searchName

        );


    if (found) {

        return found;

    }


    /* PARTIAL MATCH */

    found =
        students.find(student => {

            const name =
                cleanStudentName(student.name);


            return (

                name.includes(searchName)

                ||

                searchName.includes(name)

            );

        });


    return found || null;

}


/* =========================================================
   CHECK STUDENT PRESENT
========================================================= */

function isStudentPresent(studentName) {

    const presentStudents =
        getPresentStudents();


    const normalizedName =
        cleanStudentName(studentName);


    return presentStudents.some(student =>

        cleanStudentName(student.name) ===
        normalizedName

    );

}


/* =========================================================
   EXTRACT STUDENT NAME
========================================================= */

function extractStudentName(command) {

    let name = command;


    const removeWords = [

        "jarvis",

        "check",

        "tell",

        "show",

        "find",

        "search",

        "attendance",

        "status",

        "present",

        "absent",

        "student",

        "students",

        "is",

        "are",

        "was",

        "today",

        "ki",

        "ka",

        "kya",

        "hai",

        "hain",

        "hai kya",

        "check karo",

        "batao",

        "please"

    ];


    removeWords.forEach(word => {

        const regex =
            new RegExp("\\b" + word + "\\b", "g");


        name =
            name.replace(regex, "");

    });


    return name

        .replace(/\s+/g, " ")

        .trim();

}


/* =========================================================
   OPEN ATTENDANCE
========================================================= */

function openAttendanceSection() {

    const section =
        document.getElementById(
            "attendanceSection"
        );


    if (section) {

        section.scrollIntoView({

            behavior: "smooth",

            block: "start"

        });

    }

}


/* =========================================================
   OPEN STUDENTS
========================================================= */

function openStudentsSection() {

    const section =
        document.getElementById(
            "studentsSection"
        );


    if (section) {

        section.scrollIntoView({

            behavior: "smooth",

            block: "start"

        });

    }

}


/* =========================================================
   OPEN PENDING
========================================================= */

function openPendingSection() {

    const section =
        document.getElementById(
            "pendingSection"
        );


    if (section) {

        section.scrollIntoView({

            behavior: "smooth",

            block: "start"

        });

    }

}


/* =========================================================
   CREATE STUDENT LIST
========================================================= */

function createStudentList(students) {

    if (!students.length) {

        return "";

    }


    return students

        .map(student => student.name)

        .join(", ");

}


/* =========================================================
   INDIVIDUAL STUDENT ATTENDANCE
========================================================= */

function handleStudentAttendance(command) {

    const studentName =
        extractStudentName(command);


    if (!studentName) {

        return false;

    }


    const student =
        findStudentByName(studentName);


    if (!student) {

        return false;

    }


    openAttendanceSection();


    const present =
        isStudentPresent(student.name);


    if (present) {

        const response =
            student.name +
            " is present today.";


        updateJarvis(
            "STUDENT STATUS",
            response
        );


        speak(
            student.name +
            " present hai."
        );

    } else {

        const response =
            student.name +
            " is absent today.";


        updateJarvis(
            "STUDENT STATUS",
            response
        );


        speak(
            student.name +
            " absent hai."
        );

    }


    return true;

}


/* =========================================================
   WHO IS PRESENT
========================================================= */

function handlePresentStudents() {

    const students =
        getPresentStudents();


    openAttendanceSection();


    if (students.length === 0) {

        updateJarvis(
            "PRESENT STUDENTS",
            "No students are marked present yet."
        );


        speak(
            "Abhi tak koi student present mark nahi hua hai."
        );


        return;

    }


    const names =
        createStudentList(students);


    updateJarvis(
        "PRESENT STUDENTS",
        "Present students are: " + names
    );


    speak(
        "Present students hain: " + names
    );

}


/* =========================================================
   WHO IS ABSENT
========================================================= */

function handleAbsentStudents() {

    const students =
        getAbsentStudents();


    openStudentsSection();


    if (students.length === 0) {

        updateJarvis(
            "ABSENT STUDENTS",
            "No students are absent."
        );


        speak(
            "Koi student absent nahi hai."
        );


        return;

    }


    const names =
        createStudentList(students);


    updateJarvis(
        "ABSENT STUDENTS",
        "Absent students are: " + names
    );


    speak(
        "Absent students hain: " + names
    );

}


