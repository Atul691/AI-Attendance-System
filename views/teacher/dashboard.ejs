/* =========================================================
   SEND COMMAND TO REAL JARVIS DATABASE API
========================================================= */

async function sendCommandToJarvis(command) {

    try {

        updateJarvis(
            "CONTACTING JARVIS AI",
            "Checking the real attendance database..."
        );


        const response = await fetch(
            "/teacher/jarvis/command",
            {

                method: "POST",

                headers: {

                    "Content-Type": "application/json"

                },

                body: JSON.stringify({

                    command: command

                })

            }
        );


        const data = await response.json();


        console.log(
            "REAL JARVIS RESPONSE:",
            data
        );


        if (!data.success) {

            const errorMessage =
                data.message ||
                "JARVIS could not process this command.";


            updateJarvis(
                "JARVIS ERROR",
                errorMessage
            );


            speak(errorMessage);

            return;

        }


        updateJarvis(
            data.status || "JARVIS RESPONSE",
            data.message
        );


        speak(
            data.speak || data.message
        );


        /*
           Optional action returned by server
        */

        if (data.action === "attendance") {

            openAttendanceSection();

        }


        if (data.action === "students") {

            openStudentsSection();

        }


        if (data.action === "pending") {

            openPendingSection();

        }


        if (data.action === "refresh") {

            setTimeout(() => {

                window.location.reload();

            }, 1500);

        }


    } catch (error) {

        console.error(
            "JARVIS API ERROR:",
            error
        );


        updateJarvis(
            "CONNECTION ERROR",
            "JARVIS could not connect to the server."
        );


        speak(
            "Server se connection nahi ho pa raha hai."
        );

    }

}

